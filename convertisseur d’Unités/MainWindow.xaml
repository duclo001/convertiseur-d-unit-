<Window x:Class="convertisseur_d_Unités.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:convertisseur_d_Unités"
        mc:Ignorable="d"
                TextElement.Foreground="{DynamicResource MaterialDesignBody}"
        Background="{DynamicResource MaterialDesignPaper}"
        FontFamily="{DynamicResource MaterialDesignFont}"
        Title="MainWindow"
        Height="450"
        Width="800">
    <Grid Style="{StaticResource MargeGrid}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Bandeau Material Design : met en évidence Primary (DeepPurple) et Secondary (Lime) -->
        <Border Grid.Row="0" Style="{StaticResource HeaderBannerBorderStyle}">
            <DockPanel LastChildFill="True">
                <TextBlock DockPanel.Dock="Left" Text="Convertisseur" Style="{StaticResource HeaderBannerTitleTextStyle}" />
                <Border DockPanel.Dock="Right" Style="{StaticResource HeaderBannerAccentDotStyle}" />
            </DockPanel>
        </Border>

        <!-- MENU (spButtons) -->
        <Grid x:Name="spButtons" Grid.Row="1" Visibility="Visible">
            <Grid.RowDefinitions>
                <RowDefinition />
                <RowDefinition />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition />
                <ColumnDefinition />
            </Grid.ColumnDefinitions>

            <materialDesign:Card x:Name="cardTemperature" Grid.Row="0" Grid.Column="0">
                <StackPanel>
                    <TextBlock Text="Température" />
                    <Button x:Name="btnTemperature" Click="btnTemperature_Click">
                        <Image Source="/image/icons8-température-64.png" />
                    </Button>
                </StackPanel>
            </materialDesign:Card>

            <materialDesign:Card x:Name="cardVolume" Grid.Row="1" Grid.Column="0">
                <StackPanel>
                    <TextBlock Text="Volume" />
                    <Button x:Name="btnVolume" Click="btnVolume_Click">
                        <Image Source="/image/icons8-poids-48.png" />
                    </Button>
                </StackPanel>
            </materialDesign:Card>

            <materialDesign:Card x:Name="cardWeight" Grid.Row="0" Grid.Column="1">
                <StackPanel>
                    <TextBlock Text="Poids" />
                    <Button x:Name="btnWeight" Click="btnWeight_Click">
                        <Image Source="/image/icons8-poids-48.png" />
                    </Button>
                </StackPanel>
            </materialDesign:Card>

            <materialDesign:Card x:Name="cardLenght" Grid.Row="1" Grid.Column="1">
                <StackPanel>
                    <TextBlock Text="Longueur" />
                    <Button x:Name="btnLength" Click="btnLength_Click">
                        <Image Source="/image/icons8-longueur-80.png" />
                    </Button>
                </StackPanel>
            </materialDesign:Card>
        </Grid>

        <!-- CONVERTISSEURS -->
        <StackPanel x:Name="spConvertisseurs" Grid.Row="1" Visibility="Collapsed">
            <!-- TEMPÉRATURE (spTemperature) -->
            <StackPanel x:Name="spTemperature" Visibility="Collapsed">
                <materialDesign:Card>
                    <StackPanel Orientation="Vertical">
                        <TextBlock Text="De" />
                        <ComboBox x:Name="cbTemperatureSource"
                              materialDesign:HintAssist.Hint="Unité source"
                              SelectionChanged="cbTemperatureSource_SelectionChanged">
                            <ComboBoxItem Content="Kelvin" />
                            <ComboBoxItem Content="Celsius" />
                            <ComboBoxItem Content="Fahrenheit" />
                        </ComboBox>

                        <TextBlock Text="Vers" />
                        <ComboBox x:Name="cbTemperatureCible"
                              materialDesign:HintAssist.Hint="Unité cible"
                              SelectionChanged="cbTemperatureCible_SelectionChanged">
                            <ComboBoxItem Content="Kelvin" />
                            <ComboBoxItem Content="Celsius" />
                            <ComboBoxItem Content="Fahrenheit" />
                        </ComboBox>

                        <TextBox x:Name="txtTemperatureSource"
                             materialDesign:HintAssist.Hint="Valeur à convertir"
                             TextChanged="txtTemperatureSource_TextChanged"
                             PreviewTextInput="txtTemperatureSource_PreviewTextInput" />

                        <TextBlock x:Name="tbTemperatureResultat" Text="0" />
                    </StackPanel>
                </materialDesign:Card>
            </StackPanel>

            <!-- VOLUME (spVolume) -->
            <StackPanel x:Name="spVolume" Visibility="Collapsed">
                <materialDesign:Card>
                    <StackPanel Orientation="Vertical">
                        <TextBlock Text="De" />

                        <ComboBox x:Name="cbVolumeSource"
                              materialDesign:HintAssist.Hint="Unité source"
                              SelectionChanged="cbVolumeSource_SelectionChanged">
                            <ComboBoxItem Content="Litres" />
                            <ComboBoxItem Content="Millilitres" />
                            <ComboBoxItem Content="Mètres cubes" />
                        </ComboBox>

                        <TextBlock Text="Vers" />

                        <ComboBox x:Name="cbVolumeCible"
                              materialDesign:HintAssist.Hint="Unité cible"
                              SelectionChanged="cbVolumeCible_SelectionChanged">
                            <ComboBoxItem Content="Litres" />
                            <ComboBoxItem Content="Millilitres" />
                            <ComboBoxItem Content="Mètres cubes" />
                        </ComboBox>

                        <TextBox x:Name="txtVolumeSource"
                             materialDesign:HintAssist.Hint="Valeur à convertir"
                             TextChanged="txtVolumeSource_TextChanged"
                             PreviewTextInput="txtVolumeSource_PreviewTextInput" />

                        <TextBlock x:Name="tbVolumeResultat" Text="0" />
                    </StackPanel>
                </materialDesign:Card>
            </StackPanel>

            <!-- POIDS (spWeight) -->
            <StackPanel x:Name="spWeight" Visibility="Collapsed">
                <materialDesign:Card>
                    <StackPanel Orientation="Vertical">
                        <TextBlock Text="De" />

                        <ComboBox x:Name="cbWeightSource"
                              materialDesign:HintAssist.Hint="Unité source"
                              SelectionChanged="cbWeightSource_SelectionChanged">
                            <ComboBoxItem Content="Kilogrammes" />
                            <ComboBoxItem Content="Grammes" />
                            <ComboBoxItem Content="Livres" />
                        </ComboBox>

                        <TextBlock Text="Vers" />

                        <ComboBox x:Name="cbWeightCible"
                              materialDesign:HintAssist.Hint="Unité cible"
                              SelectionChanged="cbWeightCible_SelectionChanged">
                            <ComboBoxItem Content="Kilogrammes" />
                            <ComboBoxItem Content="Grammes" />
                            <ComboBoxItem Content="Livres" />
                        </ComboBox>

                        <TextBox x:Name="txtWeightSource"
                             materialDesign:HintAssist.Hint="Valeur à convertir"
                             TextChanged="txtWeightSource_TextChanged"
                             PreviewTextInput="txtWeightSource_PreviewTextInput" />

                        <TextBlock x:Name="tbWeightResultat" Text="0" />
                    </StackPanel>
                </materialDesign:Card>
            </StackPanel>

            <!-- LONGUEUR (spLenght) -->
            <StackPanel x:Name="spLenght" Visibility="Collapsed">
                <materialDesign:Card>
                    <StackPanel Orientation="Vertical">
                        <TextBlock Text="De" />

                        <ComboBox x:Name="cbLenghtSource"
                              materialDesign:HintAssist.Hint="Unité source"
                              SelectionChanged="cbLenghtSource_SelectionChanged">
                            <ComboBoxItem Content="Mètres" />
                            <ComboBoxItem Content="Centimètres" />
                            <ComboBoxItem Content="Pouces" />
                        </ComboBox>

                        <TextBlock Text="Vers" />

                        <ComboBox x:Name="cbLenghtCible"
                              materialDesign:HintAssist.Hint="Unité cible"
                              SelectionChanged="cbLenghtCible_SelectionChanged">
                            <ComboBoxItem Content="Mètres" />
                            <ComboBoxItem Content="Centimètres" />
                            <ComboBoxItem Content="Pouces" />
                        </ComboBox>

                        <TextBox x:Name="txtLenghtSource"
                             materialDesign:HintAssist.Hint="Valeur à convertir"
                             TextChanged="txtLenghtSource_TextChanged"
                             PreviewTextInput="txtLenghtSource_PreviewTextInput" />

                        <TextBlock x:Name="tbLenghtResultat" Text="0" />
                    </StackPanel>
                </materialDesign:Card>
            </StackPanel>

            <!-- RETOUR (spReturn) -->
            <StackPanel x:Name="spReturn"
             Visibility="Collapsed">
                <Button x:Name="btnRetour" Click="btnRetour_Click">
                    <Image Source="/image/return.png" />
                </Button>
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>


